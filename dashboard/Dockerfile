FROM python:3.10-slim-buster AS builder

WORKDIR /app

COPY backend/requirements.txt ./requirements.txt
COPY utilities ./utilities
COPY config ./config
# RUN apt-get update
# RUN apt-get install -y python3.10
# RUN apt-get install -y python3-pip
# RUN pip install --no-cache-dir --break-system-packages -r requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
RUN python3 utilities/generate_config_models.py --zod
RUN python3 utilities/generate_database_models.py --zod

FROM node:20.15

ARG AUTOGENERATED_OUTPUT_FOLDER=/app/dashboard/src/models/autogenerated
COPY --from=builder ${AUTOGENERATED_OUTPUT_FOLDER}/database_models.ts ${AUTOGENERATED_OUTPUT_FOLDER}/database_models.ts 
COPY --from=builder ${AUTOGENERATED_OUTPUT_FOLDER}/configuration_models.ts ${AUTOGENERATED_OUTPUT_FOLDER}/configuration_models.ts 

# ARG APP_WORKDIR

# WORKDIR ${APP_WORKDIR}
WORKDIR /app

COPY dashboard/src ./src
COPY dashboard/public ./public
COPY [\
    "dashboard/package.json", \
    "dashboard/yarn.lock",\
    "dashboard/postcss.config.js",\
    "dashboard/tailwind.config.js",\
    "dashboard/tsconfig.json",\
    "dashboard/.eslintrc.json",\
    "./"\
]
COPY utilities ./utilities

COPY dashboard/next.config.production.js ./next.config.js
COPY dashboard/.env.production ./.env

COPY backend/requirements.txt ./requirements.txt
RUN apt-get update
RUN apt-get install -y python3.10
RUN apt-get install -y python3-pip
RUN pip install --no-cache-dir --break-system-packages -r requirements.txt
RUN python3 utilities/generate_config_models.py --zod
RUN python3 utilities/generate_database_models.py --zod

RUN ["yarn", "--network-timeout", "100000", "install"]
RUN ["npx", "next-ws-cli@latest", "patch"]
RUN ["yarn", "build"]

CMD ["yarn", "start"]
