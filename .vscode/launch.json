        {
            "name": "Python: FastAPI (Run outside Docker)",
            "type": "debugpy",
            "request": "launch",
            "module": "api.main", // Runs the __main__.py in the 'api' package
            "cwd": "${workspaceFolder}/backend", // Sets the current working directory for the launch process to 'backend/'
            "envFile": "${workspaceFolder}/.env", // Loads environment variables from the root .env file
            "justMyCode": true, // Focuses debugging on your code, ignoring library code
            "console": "integratedTerminal" // Displays output in VS Code's integrated terminal
            // You can add "--reload" to the "args" array if you want live reloading for development.
            // "args": [
            //     "--reload" 
            // ]
        },
        {
            "name": "Host Services API",
            "type": "python",
            "request": "launch",
            "module": "host_services",
            "justMyCode": false,
            "env": {
                // "CONFIG_FILE_DIR": "${workspaceFolder}/config",
                "HOST_SERVICES_PORT": "8001",
                "CONTAINERIZED": "false",
                // "CONFIG_FILE": "system_configuration.yaml",
                // "PYTHONPATH": "${workspaceFolder}/backend",
            }
        },
        {
            "name": "Next.js: debug server-side frontend app",
            "type": "node-terminal",
            "request": "launch",
            "command": "yarn dev",
            "cwd": "${workspaceFolder}/dashboard",
            "env": {
                // "NEXTAUTH_URL": "http://192.168.2.125:3000"
                "NODE_OPTIONS": "--inspect"
                // "NEXTAUTH_URL": "http://localhost:3000"
            },
            "serverReadyAction": {
                "pattern": "started server on .+, url: (https?://.+)",
                "uriFormat": "%s",
                // "action": "debugWithChrome"
            },
            "outFiles": [
                "${workspaceFolder}/.next/server/**/*.js"
            ],
        },
        {
            "name": "Next.js: New debug server-side frontend app",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}/dashboard",
            "runtimeExecutable": "yarn",
            "runtimeArgs": [
                "dev"
            ],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "env": {
                "NODE_OPTIONS": "--inspect=9230" // Changed port here
            }
        },
    
        {
            "name": "Next.js: start server-side frontend app",
            "type": "node-terminal",
            "request": "launch",
            "command": "yarn start",
            "cwd": "${workspaceFolder}/dashboard",
            "serverReadyAction": {
                "pattern": "started server on .+, url: (https?://.+)",
                "uriFormat": "%s",
                // "action": "debugWithChrome"
            },
            "outFiles": [
                "${workspaceFolder}/.next/server/**/*.js"
            ],
        }
    ]
}