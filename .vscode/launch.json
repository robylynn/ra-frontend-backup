    "configurations": [
        // {
        //     "name": "Python Backend",
        //     "type": "python",
        //     "request": "launch",
        //     "module": "backend",
        //     "justMyCode": false,
        //     "env": {
        //         "CONFIG_FILE_DIR": "${workspaceFolder}/config",
        //         "CONTAINERIZED": "false",
        //         "CONFIG_FILE": "system_configuration.yaml",
